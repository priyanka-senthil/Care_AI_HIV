# Copy this file to .env and fill in your values.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Fill this in after the tuning job finishes (see tuning/run_tuning.py output).
CAREAI_TUNED_MODEL=

# Set to "mock" to run the whole app offline without Google Cloud (for demos and tests).
CAREAI_BACKEND=vertex
